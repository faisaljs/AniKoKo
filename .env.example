# AniKoKo backend configuration
# Copy to .env and edit. All vars are optional — defaults are shown.

# --- server ---
ANIKOKO_HOST=0.0.0.0
ANIKOKO_PORT=8000
ANIKOKO_CORS_ORIGINS=*

# --- outbound scraping ---
# Optional HTTP proxy for all scraper + resolver outbound requests.
# Format: http://user:pass@host:port
# ANIKOKO_SCRAPE_PROXY=http://user:pass@host:port

# --- cache ---
# Bounded LRU max entries. Under default config this is ~1024 cached
# responses, which is plenty for single-user browsing.
# ANIKOKO_CACHE_MAX=1024

# --- proxy retries ---
# Number of retries on transport errors (timeouts, connection resets)
# for /proxy/stream, /proxy/download, /proxy/img. HTTP 4xx/5xx from
# upstream is NOT retried — that's the upstream's decision.
# ANIKOKO_PROXY_RETRIES=2